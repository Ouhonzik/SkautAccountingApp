# Vzor souboru .env - zkopiruj ho jako .env a vypln hodnoty.
# Soubor .env se NIKDY nenahrava na GitHub (je v .gitignore).
#
# Appka nabehne i bez .env - lokalne neni povinna zadna promenna, vsechny
# maji vychozi hodnotu v app/config.py. Na serveru jsou povinne promenne
# z oddilu 1. Nazvy se muzou psat velkymi i malymi pismeny.
#
# Pravidla zapisu: bez mezer kolem "=", bez uvozovek; true/false malymi
# pismeny; cisla s desetinnou teckou.


# =====================================================================
# 1. POVINNE NA SERVERU (lokalne staci vychozi hodnota)
# =====================================================================

# Tajny klic, kterym appka podepisuje prihlasovaci cookie. Kdo ho zna,
# prihlasi se za kohokoli.
# Povinne: na serveru ano - prazdny, zastupny nebo kratsi nez 32 znaku klic
#   appka na serveru odmitne nabehnout. Lokalne ne, jen upozorni.
# Format: nahodny retezec aspon 32 znaku, vyrob ho prikazem
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# Vychozi: zmen-me-pred-nasazenim
SECRET_KEY=

# Posilat prihlasovaci cookie jen sifrovane (HTTPS).
# Povinne: na serveru ano, hodnota true (appka bezi za Caddy s HTTPS) -
#   s jinou hodnotou appka na serveru odmitne nabehnout.
#   Lokalne na http://localhost musi zustat false, jinak se neprihlasis.
# Format: true / false
# Vychozi: false
COOKIE_HTTPS_ONLY=false

# Verejna adresa appky - z ni se skladaji odkazy v e-mailech (pozvanka,
# obnova hesla, potvrzeni e-mailu) a povolene domeny pro CSRF a Host
# (musi presne sedet s adresou v prohlizeci, jinak appka POST odmitne
# hlaskou "Požadavek odmítnut (cizí původ)." a GET hlaskou "Invalid host
# header").
# Povinne: na serveru ano, jinak odkazy v e-mailech vedou na localhost.
#   Adresa mimo localhost zaroven zapne kontroly serveroveho rezimu pri
#   startu (silny SECRET_KEY, COOKIE_HTTPS_ONLY=true, SMTP, RELOAD=false).
# Format: adresa vcetne https:// a BEZ lomitka na konci,
#   napr. https://ucty.nase-domena.cz
# Vychozi: http://localhost:8000
VEREJNA_URL=http://localhost:8000

# Automaticky restart serveru pri zmene .py souboru.
# Povinne: na serveru musi zustat false. Lokalne pri vyvoji si zapni true.
# Format: true / false
# Vychozi: false
RELOAD=false

# SMTP pro odesilani e-mailu (pozvanky, obnova hesla, potvrzeni e-mailu).
# Povinne: na serveru ano, vsech sest. Kdyz SMTP_HOST zustane prazdny,
#   e-mail se neodesle, jen se ulozi jako .eml soubor do data/posta/
#   (takhle bezi vyvoj i testy; appka to v hlaskach rekne). Na serveru
#   prazdny SMTP_HOST start odmitne. Vyplneny SMTP_HOST s prazdnym
#   SMTP_ODESILATEL start odmitne vzdy.
# Pro @skaut.cz (Google Workspace): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
#   SMTP_USER = cela adresa uctu, SMTP_PASSWORD = "heslo aplikace"
#   (vyrobi se v nastaveni Google uctu se zapnutym dvoufazovym overenim,
#   NE bezne heslo k uctu).
# Vychozi: SMTP_HOST, SMTP_USER, SMTP_PASSWORD, SMTP_ODESILATEL prazdne,
#   SMTP_PORT 587, SMTP_SIFROVANI starttls.
SMTP_HOST=
SMTP_PORT=587
# Sifrovani spojeni: starttls (port 587, vychozi) nebo ssl (port 465 -
# spojeni je sifrovane od zacatku). Hodnota musi sedet s portem.
SMTP_SIFROVANI=starttls
SMTP_USER=
SMTP_PASSWORD=
# Adresa v hlavicce "Od" - pro Google musi byt stejna jako SMTP_USER
# (nebo jeji alias), napr. jmeno.prijmeni@skaut.cz
SMTP_ODESILATEL=


# Promenna PROSTREDI tu schvalne neni. "server" ji nastavuje
# systemd sluzba uctovani.service (Environment=PROSTREDI=server). Do .env ji
# nepis: systemd necha hodnoty z .env prebit hodnoty ze sluzby, takze
# radek PROSTREDI=vyvoj by na serveru kontroly vypnul.


# =====================================================================
# 2. DOPORUCENE (bez nich appka jede, ale neco v ni chybi)
# =====================================================================

# Klic ke Google Gemini pro cteni uctenek - bezplatny, z Google AI Studia:
# https://aistudio.google.com/apikey
# JEN PRO VYVOJ. Na serveru se bezplatny klic nepouzije (podminky Gemini API
# ho pro uzivatele v EHP zakazuji) - tam je potreba GOOGLE_API_KEY_PLACENY.
# Typ klice: Google od 28. 5. 2026 zaklada v AI Studiu klice jako "auth key"
#   a Gemini API ODMITA pozadavky z NEOMEZENYCH standardnich klicu (v AI Studiu
#   u nich stoji "Unrestricted"). Pouzij novy klic z AI Studia, nebo standardni klic
#   s omezenim "Restrict to Gemini API only". Unikly neomezeny klic jde zneuzit na
#   kazde API v projektu.
# Povinne: ne. Bez nej cteni pres AI skonci chybou a uctenky se vyplnuji rucne.
# Format: retezec z AI Studia, bez uvozovek
# Vychozi: prazdne
GOOGLE_API_KEY=


# =====================================================================
# 3. NEPOVINNE (vychozi hodnota obvykle staci)
# =====================================================================

# Klic ke Gemini z projektu se zapnutou platbou (rychlejsi cteni).
# Typ klice: stejna pravidla jako u GOOGLE_API_KEY vyse (nesmi byt neomezeny).
# Povinne: pri vyvoji ne, na serveru ANO pro cteni uctenek - tam se cte jen timto
#   klicem. Pri vyvoji: kdyz zustane prazdny, prepinac Zdarma/Placeny se v appce
#   vubec neukaze a cte se jen zdarma; na placeny se nikdy neprepina samo.
# Format: retezec z AI Studia
# Vychozi: prazdne
GOOGLE_API_KEY_PLACENY=

# Ktery model Gemini cte uctenky.
# Povinne: ne. Model musi znat cenik CENIK_USD_ZA_1M v app/services/tarif.py,
#   jinak se u nej nespocita utrata.
# Format: nazev modelu z dokumentace Gemini API, napr. gemini-3.5-flash
# Vychozi: gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash

# Kurz dolaru pro orientacni odhad utraty za placeny klic v Kc.
# Povinne: ne, staci obcas rucne opravit.
# Format: cislo s desetinnou teckou, napr. 23 nebo 23.45
# Vychozi: 23
KURZ_USD_CZK=23

# Klic z developer.mapy.com pro mapu a vypocet km v cestovnim prikazu.
# Povinne: ne. Kdyz zustane prazdny, mapa se v cestaku neukaze a km se
#   pisou rucne.
# Format: retezec z developer.mapy.com
# Vychozi: prazdne
MAPY_API_KEY=

# Slozka s databazi (akce.db), nahranymi soubory, nahledy a ulozenymi e-maily.
# Povinne: ne.
# Format: cesta relativne ke koreni projektu (data) nebo absolutni
#   (napr. C:\zkouska\data nebo /home/uctovani/data)
# Vychozi: data
# Lokalni vyvoj a zkouseni: DATA_DIR=data-vyvoj s ukazkovymi daty (viz README).
#   Ostra `data/` patri jen serveru - hotova vyuctovani a udaje deti.
DATA_DIR=data

# Heslo ukazkovych uctu, ktere vyrobi `python -m app.seed` (jen lokalni vyvoj,
# na server nepatri). Kdyz zustane prazdne, seed vygeneruje nahodne a vypise ho.
# Povinne: ne. Pozor: tady nikdy nepis heslo, ktere pouzivas jinde.
# Format: text, ktery projde kontrolou hesla jako v appce (jinak seed skonci chybou)
# Vychozi: prazdne (seed vygeneruje heslo)
SEED_HESLO=

# Port, na kterem appka posloucha.
# Povinne: ne. Na serveru musi sedet s portem v konfiguraci Caddy.
# Format: cele cislo
# Vychozi: 8000
PORT=8000

# Adresa, na ktere appka posloucha. Vychozi 127.0.0.1 = jen z tohoto pocitace,
# a to staci lokalne i na serveru, kde Caddy bezi primo na hostiteli.
# Povinne: ne. Meni se jen na serveru, kde Caddy bezi v Dockeru a k appce se
#   dostava pres branu Docker site (napr. 172.18.0.1).
#   Na serveru appka odmitne nabehnout s 0.0.0.0 nebo :: (byla by dostupna
#   zvenku bez HTTPS) i s hodnotou, ktera neni IP adresa. Lokalne se nekontroluje.
# Format: jedna IP adresa
# Vychozi: 127.0.0.1
# HOST=127.0.0.1

# Z kterych adres veri appka hlavicce X-Forwarded-For (skutecna IP navstevnika
# od reverse proxy; bez ni by appka videla jen IP proxy a omezeni pokusu
# o prihlaseni by pocitalo vsechny dohromady). Komu se veri, ten si muze zvolit,
# jakou IP appka uvidi - proto jen adresy proxy.
# Povinne: ne. Meni se jen spolu s HOST pro Caddy v Dockeru (napr. 172.18.0.0/16).
#   Na serveru appka odmitne nabehnout s *, s prazdnou hodnotou, se siti
#   pokryvajici vse (0.0.0.0/0) i s neplatnou polozkou (uvicorn ji jinak
#   potichu zahodi).
# Format: IP adresy nebo site v zapisu CIDR oddelene carkou, napr.
#   127.0.0.1,172.18.0.0/16
# Vychozi: 127.0.0.1
# FORWARDED_ALLOW_IPS=127.0.0.1

# Nejnizsi uroven, kterou appka zapisuje do logu serveru (journalctl).
# Povinne: ne. Do logu se nikdy nezapisuji tokeny, hesla ani query string.
# Format: DEBUG, INFO, WARNING nebo ERROR
# Vychozi: INFO (DEBUG jen lokalne pri ladeni)
# LOG_UROVEN=INFO

# Udaje strediska v hlavicce tiskopisu PPD/VPD, cestovnich prikazu a vsech
# Excelu. Vyplň vlastní údaje svého střediska - vychozi hodnoty jsou jen
# zastupne ("Název střediska", "Adresa střediska", ostatni prazdne).
# Povinne: ne, ale bez nich budou tiskopisy se zastupnymi udaji.
# Format: text
# Vychozi: zastupne hodnoty (viz app/config.py)
# STREDISKO_NAZEV=
# STREDISKO_SIDLO=
# STREDISKO_ICO=
# STREDISKO_DIC=
# Cislo jednotky, ktere se predvyplni na kazdem cestovnim prikazu.
# STREDISKO_JEDNOTKA=


# =====================================================================
# 4. ZASTARALE - uz se nepouzivaji, nevyplnuj
# =====================================================================

# Prihlaseni resi ucty v databazi (zaklada je `uv run spravce`). Tyhle dve
# promenne cte jen stara migrace b42fe20a9964 pri prechodu ze starsi verze:
# z nich jednou zalozi spravce. Na nove instalaci je nech zakomentovane.
# APP_USERNAME=
# APP_PASSWORD_HASH=
